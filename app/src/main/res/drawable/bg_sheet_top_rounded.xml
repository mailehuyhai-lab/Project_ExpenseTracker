<?xml version="1.0" encoding="utf-8"?>
<!--
    SHEET NHẬP LIỆU màn "Thêm giao dịch" - bản kính mờ:
    kéo lên đè -28dp lên header aurora, viền sáng 1dp chạy dọc
    đường cong trên + fill kính 91% trắng (đủ đục để chữ ink đạt AA)
    + vệt sáng chéo phía trên. Kéo tràn mép nên chỉ cần bo 2 góc trên.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Viền sáng theo cong trên (2 bên/đáy tràn khỏi màn hình) -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="28dp"
                android:topRightRadius="28dp" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_edge_light" />
        </shape>
    </item>

    <!-- Thân kính: fill 91% + vệt sáng chéo -->
    <item android:top="1dp">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="28dp"
                        android:topRightRadius="28dp" />
                    <solid android:color="@color/glass_panel_strong" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle" android:dither="true">
                    <corners
                        android:topLeftRadius="28dp"
                        android:topRightRadius="28dp" />
                    <gradient
                        android:type="linear"
                        android:angle="315"
                        android:startColor="@color/glass_fill_top"
                        android:endColor="@color/glass_sheen_edge" />
                </shape>
            </item>
        </layer-list>
    </item>

</layer-list>
