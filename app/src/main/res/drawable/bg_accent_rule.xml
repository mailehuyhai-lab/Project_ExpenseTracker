<?xml version="1.0" encoding="utf-8"?>
<!--
    VẠCH ACCENT dưới số dư (2dp x 44dp) - tín hiệu "control panel":
    gradient ngang mint -> tan dần. Chỉ dùng trên nền TỐI.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="2dp" />
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="@color/neon_mint"
        android:endColor="@color/neon_mint_fade" />
</shape>
