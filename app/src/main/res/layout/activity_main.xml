<?xml version="1.0" encoding="utf-8"?><!--
    MÀN HÌNH CHÍNH (DASHBOARD) - chủ đề Aurora Glass
    1. Thẻ số dư kính 3 lớp: aurora riêng -> kính -> nội dung
    2. Danh sách giao dịch kính mờ + Empty State
    3. Nút Extended FAB
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aurora_backdrop"
    tools:context=".MainActivity">

    <!-- clipChildren=false để viền/vệt kính tràn mép không bị cắt -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <!-- ============================================================
             THẺ SỐ DƯ KÍNH - trong suốt, bo 30dp; FrameLayout bên trong
             xếp 2 lớp nền: aurora riêng (background) + kính (foreground)
             ============================================================ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTongQuan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="30dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <!-- FrameLayout mang 2 lớp nền:
                 background = mảng aurora riêng, foreground = kính + viền + vệt sáng.
                 Dùng background/foreground thay vì View con match_parent vì
                 View con trong FrameLayout wrap_content bị đo thành full màn hình
                 (quirk View.getDefaultSize với AT_MOST). FrameLayout hỗ trợ
                 foreground từ API 1 nên an toàn minSdk 21. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_balance_aurora"
                android:clipChildren="false"
                android:foreground="@drawable/bg_glass_slab">

                <!-- Nội dung -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="vertical"
                    android:padding="20dp">

                <!-- Dòng chào + icon ví -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chao_hoi"
                            android:textColor="@color/white_alpha_90"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvThangNam"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:letterSpacing="0.12"
                            android:textAllCaps="true"
                            android:textColor="@color/text_on_aurora_dim"
                            android:textSize="10sp"
                            tools:text="THÁNG 8, 2026" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_translucent"
                        android:contentDescription="@string/app_name"
                        android:padding="10dp"
                        android:src="@drawable/ic_wallet"
                        app:tint="@color/surface_white" />
                </LinearLayout>

                <!-- Nhãn "Tổng số dư" + số dư tracking âm kiểu premium -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:letterSpacing="0.12"
                    android:text="@string/so_du_hien_tai"
                    android:textColor="@color/text_on_aurora_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSoDu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.01"
                    android:maxLines="1"
                    android:textColor="@color/white_alpha_90"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    tools:text="12.450.000 đ" />

                <!-- Vạch accent mint "control panel" 2x44dp -->
                <View
                    android:layout_width="44dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_accent_rule" />

                <!-- Hai ô Tổng thu / Tổng chi -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_translucent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@string/tong_thu"
                            android:src="@drawable/ic_trend_up"
                            app:tint="@color/emerald_500" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tong_thu"
                                android:textColor="@color/text_on_aurora_dim"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvTongThu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/surface_white"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="+20.000.000 đ" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_translucent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@string/tong_chi"
                            android:src="@drawable/ic_trend_down"
                            app:tint="@color/red_expense_on_dark" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tong_chi"
                                android:textColor="@color/text_on_aurora_dim"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvTongChi"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/surface_white"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="-7.550.000 đ" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- ============================================================
             TIÊU ĐỀ MỤC LỊCH SỬ + SỐ LƯỢNG GIAO DỊCH
             ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/lich_su_giao_dich"
                android:textColor="@color/text_on_aurora"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSoLuong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_on_aurora_dim"
                android:textSize="13sp"
                tools:text="12 giao dịch" />
        </LinearLayout>

        <!-- ============================================================
             DANH SÁCH GIAO DỊCH + TRẠNG THÁI RỖNG
             ============================================================ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:layoutAnimation="@anim/layout_animation_fall_down"
                android:paddingBottom="96dp"
                android:scrollbars="none"
                tools:itemCount="4"
                tools:listitem="@layout/item_giao_dich" />

            <!-- Empty State: hiện khi chưa có giao dịch nào -->
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingBottom="60dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:contentDescription="@string/empty_title"
                    android:src="@drawable/ic_empty_state" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/empty_title"
                    android:textColor="@color/text_on_aurora"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/empty_subtitle"
                    android:textColor="@color/text_on_aurora_dim"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <!-- ============================================================
         NÚT THÊM GIAO DỊCH (Extended FAB - tự thu gọn khi cuộn danh sách)
         ============================================================ -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/mo_ta_them_giao_dich"
        android:text="@string/them"
        android:textColor="@color/surface_white"
        android:textStyle="bold"
        app:backgroundTint="@color/teal_700"
        app:elevation="8dp"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/neon_mint"
        app:rippleColor="@color/ripple_light"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.ExpenseTracker.Fab" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
