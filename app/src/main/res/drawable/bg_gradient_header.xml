<?xml version="1.0" encoding="utf-8"?>
<!--
    Gradient dọc cho phần header của màn hình "Thêm giao dịch".
    angle=270 => màu bắt đầu ở TRÊN và chuyển dần xuống DƯỚI,
    nhờ vậy màu status bar (teal_800) khớp liền mạch với header.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="270"
        android:centerColor="@color/teal_700"
        android:endColor="@color/teal_600"
        android:startColor="@color/teal_800"
        android:type="linear" />
</shape>
