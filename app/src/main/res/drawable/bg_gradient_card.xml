<?xml version="1.0" encoding="utf-8"?>
<!--
    Gradient sang trọng cho Card "Tổng số dư" ở màn hình chính.
    angle=315 => màu chạy chéo từ góc trên-trái xuống góc dưới-phải.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="24dp" />

    <gradient
        android:angle="315"
        android:centerColor="@color/teal_600"
        android:endColor="@color/teal_500"
        android:startColor="@color/teal_800"
        android:type="linear" />
</shape>
