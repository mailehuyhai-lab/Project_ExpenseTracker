<?xml version="1.0" encoding="utf-8"?>
<!--
    HEADER AURORA của màn "Thêm giao dịch": gradient chéo teal thẫm ->
    chàm + 2 khối sáng radial (cyan trên-trái, tím dưới-phải) tràn mép.
    angle=270 ở lớp gốc => màu đậm nhất nằm TRÊN, khớp liền mạch với
    status bar teal_800 của Theme.ExpenseTracker.Add.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lớp gốc: đậm trên -> nhạt dưới -->
    <item>
        <shape android:shape="rectangle" android:dither="true">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/teal_800"
                android:centerColor="@color/teal_700"
                android:endColor="@color/aurora_indigo" />
        </shape>
    </item>

    <!-- Khối cyan góc trên-trái -->
    <item
        android:left="-80dp"
        android:top="-120dp"
        android:right="100dp"
        android:bottom="160dp">
        <shape android:shape="oval" android:dither="true">
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:startColor="@color/aurora_blob_cyan"
                android:endColor="@color/aurora_fade_out" />
        </shape>
    </item>

    <!-- Khối tím cạnh phải-dưới -->
    <item
        android:left="120dp"
        android:top="140dp"
        android:right="-140dp"
        android:bottom="-60dp">
        <shape android:shape="oval" android:dither="true">
            <gradient
                android:type="radial"
                android:gradientRadius="300dp"
                android:startColor="@color/aurora_blob_violet"
                android:endColor="@color/aurora_fade_out" />
        </shape>
    </item>

</layer-list>
