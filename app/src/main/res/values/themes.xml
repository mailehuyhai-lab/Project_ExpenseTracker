<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================
         THEME GỐC - Material Design 3 (khoá sáng để giao diện
         luôn hiển thị đúng như thiết kế trên mọi thiết bị)
         ============================================================ -->
    <style name="Base.Theme.ExpenseTracker" parent="Theme.Material3.Light.NoActionBar">

        <!-- Bộ màu chính -->
        <item name="colorPrimary">@color/teal_700</item>
        <item name="colorOnPrimary">@color/surface_white</item>
        <item name="colorPrimaryContainer">@color/pastel_teal</item>
        <item name="colorOnPrimaryContainer">@color/teal_900</item>
        <item name="colorSecondary">@color/teal_600</item>
        <item name="colorOnSecondary">@color/surface_white</item>

        <!-- Container / tertiary: ánh xạ đủ để không còn màu mặc định (tím) của M3 lộ ra -->
        <item name="colorSecondaryContainer">@color/pastel_teal</item>
        <item name="colorOnSecondaryContainer">@color/teal_900</item>
        <item name="colorTertiary">@color/teal_600</item>
        <item name="colorOnTertiary">@color/surface_white</item>
        <item name="colorTertiaryContainer">@color/pastel_indigo</item>
        <item name="colorOnTertiaryContainer">@color/teal_900</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <!-- Bề mặt & chữ -->
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/pastel_gray</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorError">@color/red_expense</item>
        <item name="android:colorBackground">@color/screen_background</item>

        <!-- Thanh trạng thái cùng màu nền để giao diện liền mạch -->
        <item name="android:statusBarColor">@color/screen_background</item>

        <!-- Nền cửa sổ = aurora thẫm: hết chớp trắng khi mở app/cuộn nhanh -->
        <item name="android:windowBackground">@color/screen_background</item>

        <!-- Mọi hộp thoại trong app đều bo góc lớn -->
        <item name="alertDialogStyle">@style/MaterialAlertDialog.ExpenseTracker</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ExpenseTracker.Dialog</item>
    </style>

    <!-- Theme dùng cho MainActivity (khai báo trong AndroidManifest) -->
    <style name="Theme.ExpenseTracker" parent="Base.Theme.ExpenseTracker" />

    <!-- Theme riêng cho màn hình Thêm giao dịch:
         status bar teal_800 khớp với đỉnh gradient của header -->
    <style name="Theme.ExpenseTracker.Add" parent="Base.Theme.ExpenseTracker">
        <item name="android:statusBarColor">@color/teal_800</item>
    </style>

    <!-- ============================================================
         HỘP THOẠI BO GÓC 24dp (dùng khi xác nhận xoá giao dịch)
         ============================================================ -->
    <style name="ShapeAppearance.ExpenseTracker.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="MaterialAlertDialog.ExpenseTracker" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ExpenseTracker.Dialog</item>
    </style>

    <style name="ThemeOverlay.ExpenseTracker.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ExpenseTracker.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.ExpenseTracker.Dialog.Button.Danger</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.ExpenseTracker.Dialog.Button.Neutral</item>
    </style>

    <style name="Widget.ExpenseTracker.Dialog.Button.Danger" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/red_expense</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.ExpenseTracker.Dialog.Button.Neutral" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ============================================================
         BO GÓC EXTENDED FAB (Dashboard)
         ============================================================ -->
    <style name="ShapeAppearance.ExpenseTracker.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- ============================================================
         NÚT SEGMENTED CONTROL (Thu / Chi)
         insetTop/Bottom = 0 để nút lấp kín viên thuốc nền
         ============================================================ -->
    <style name="Widget.ExpenseTracker.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">100dp</item>
        <item name="elevation">0dp</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">18dp</item>
    </style>

    <!-- ============================================================
         NÚT CHÍNH (Lưu giao dịch)
         ============================================================ -->
    <style name="Widget.ExpenseTracker.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="backgroundTint">@color/teal_700</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">@color/surface_white</item>
        <item name="elevation">3dp</item>
    </style>

    <!-- ============================================================
         NHÃN TIÊU ĐỀ NHỎ CỦA TỪNG Ô NHẬP LIỆU
         ============================================================ -->
    <style name="TextAppearance.ExpenseTracker.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
